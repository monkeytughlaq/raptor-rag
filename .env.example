# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-gpt-deployment-name
AZURE_OPENAI_VERSION=2024-10-21

# Database Configuration (NEW)
DATABASE_URL=postgresql://raptor:raptor@postgres:5432/raptor_rag
# For local development without Docker:
# DATABASE_URL=postgresql://raptor:raptor@localhost:5432/raptor_rag
# For SQLite (development only):
# DATABASE_URL=sqlite:///./raptor_rag.db

# Authentication Configuration (NEW)
JWT_SECRET_KEY=your_secret_key_here_change_this_to_random_string
PASSWORD_SALT=your_password_salt_here_change_this
ACCESS_TOKEN_EXPIRE_DAYS=7

# Learning Engine Settings (NEW)
ENABLE_LEARNING=true
ENABLE_USER_TRACKING=true
FEEDBACK_THRESHOLD=3
RETRAINING_FREQUENCY=daily
QUERY_SIMILARITY_THRESHOLD=0.85
MIN_FEEDBACK_COUNT=10

# Retrieval Configuration (NEW)
DEFAULT_BFS_THRESHOLD=0.5
DEFAULT_MAX_DOCS=20

# Caching Configuration (NEW)
ENABLE_CONTEXT_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=100

# Analytics Configuration (NEW)
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# Feature Flags (NEW)
ENABLE_ADMIN_DASHBOARD=true
ENABLE_QUERY_HISTORY=true
ENABLE_FEEDBACK_UI=true

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract  # Docker path
# For local development:
# TESSERACT_CMD=/usr/local/bin/tesseract  # macOS
